{
  "name": "clinic-desktop",
  "version": "1.2.0",
  "private": true,
  "description": "离线单机诊所处方管理",
  "author": "Hospital contributors",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "node tools/clean-build.cjs && node tools/check-modules.cjs && tsc -p tsconfig.json && vite build",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:ui": "node tests/ui.cjs",
    "package": "npm run build && electron-builder --win nsis --x64",
    "export:legacy": "npm run build && node tools/export-legacy.cjs",
    "test:migration": "node tests/migration-ui.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "42.0.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "local.clinic.desktop",
    "productName": "诊所助手",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Clinic-Setup-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "mysql2": "^3.15.0",
    "zod": "^4.6.5"
  }
}
